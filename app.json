{
  "expo": {
    "name": "OneLife",
    "slug": "onelife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/OneLifeIconIOS.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.commitissues.onelife",
      "infoPlist": {
        "NSHealthShareUsageDescription": "This app requires HealthKit access to read your daily step count.",
        "NSHealthUpdateUsageDescription": "This app requires HealthKit access to read your daily step count.",
        "UIBackgroundModes": [
          "fetch",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "appleTeamId": "79SD3C5XQK"
    },
    "android": {
      "package": "com.commitissues.onelife",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/OneLifeIconAndroid.png",
        "backgroundImage": "./assets/OneLifeIconAndroid.png",
        "monochromeImage": "./assets/OneLifeIconAndroid.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "@kayzmann/expo-healthkit",
        {
          "healthShareUsageDescription": "This app requires HealthKit access to read your daily step count.",
          "healthUpdateUsageDescription": "This app requires HealthKit access to read your daily step count."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "useFrameworks": "static",
            "useSwiftPackageManager": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "343d8b13-ec83-42af-a61b-b43eb8b56f4b"
      }
    }
  }
}
